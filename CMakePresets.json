{
  "version": 3,
  "configurePresets": [
    {
      "name": "compiler-llvm",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_C_COMPILER": "/home/adlyq/.local/share/LLVM-ET-Arm/bin/clang",
        "CMAKE_CXX_COMPILER": "/home/adlyq/.local/share/LLVM-ET-Arm/bin/clang++",
        "CMAKE_ASM_COMPILER": "/home/adlyq/.local/share/LLVM-ET-Arm/bin/clang"
      }
    },
    {
      "name": "compiler-gcc",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_C_COMPILER": "arm-none-eabi-gcc",
        "CMAKE_CXX_COMPILER": "arm-none-eabi-g++",
        "CMAKE_ASM_COMPILER": "arm-none-eabi-gcc"
      }
    },
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "${sourceDir}/cmake/toolchain.cmake",
      "inherits": ["compiler-llvm"],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release-base",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "LOCK_MCU": "ON"
      }
    },
    {
      "name": "Debug-stm32-NO",
      "displayName": "Debug NPN Normal Open",
      "inherits": "base",
      "cacheVariables": {
        "Output": "NPN;LIGHT_OPEN"
      }
    },
    {
      "name": "Debug-stm32-PO",
      "displayName": "Debug PNP Normal Open",
      "inherits": "base",
      "cacheVariables": {
        "Output": "PNP;LIGHT_OPEN"
      }
    },
    {
      "name": "Release-stm32-PC",
      "displayName": "Debug PNP Normal Close",
      "inherits": "release-base",
      "cacheVariables": {
        "Output": "PNP;LIGHT_CLOSE"
      }
    }
  ]
}
